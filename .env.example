# TG Ezy AI OS — environment configuration
# Copy to .env and fill in your values.

# Telegram bot token (required) — from @BotFather
BOT_TOKEN=your-telegram-bot-token

# AI provider
# NOTE: not read by the code — src/aiProvider.ts calls Mistral directly.
# Kept as a marker for a future multi-provider switch; setting it has no effect.
# AI_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key

# AI tuning (optional)
AI_MODEL=mistral-tiny
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=30000
AI_RETRIES=3

# Web server
PORT=3000
# Public base URL for webhook links shown in the bot (e.g. https://your-app.fly.dev)
PUBLIC_URL=
# Comma-separated allowed origins for the dashboard API (default * = all)
CORS_ORIGIN=
# Requests per minute per IP for the /api/chat + inbox reply endpoints
RATE_LIMIT=30

# Unified inbox simulation (default ON). Set to false to disable seeding.
INBOX_SIM=true

# Monetization (optional)
ADMIN_TELEGRAM_ID=
PRO_ACCESS_IDS=

# Web auth + billing (optional until configured)
# Long random string (>=32 chars). Sessions are HMAC-signed.
# STRONGLY RECOMMENDED in production: when unset the server falls back to a
# random per-boot secret, so every restart or redeploy signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Google sign-in OAuth client ID (Web application) — enables the "Continue with Google" button.
GOOGLE_CLIENT_ID=
# Public bot username (e.g. MyEzBot) — enables the Telegram Login Widget on /login.
BOT_USERNAME=
# Dev-only: when set to true, Magic Key codes are returned to the browser instead of emailed.
# Auto-fallbacks to on-screen preview whenever EMAIL_API_KEY/EMAIL_FROM are unset.
MAGIC_DEV_PREVIEW=true
# Magic Key email delivery via Resend (no SDK — direct REST). Codes are emailed when both are set.
EMAIL_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com
# Stripe / USDT placeholders — leave empty until payments go live.
STRIPE_SECRET_KEY=
# REQUIRED for /api/billing/webhook. Without it the endpoint returns 503 and
# refuses every event, because an unverified webhook is a free plan upgrade for
# anyone who can POST JSON. Get it from Stripe Dashboard > Developers > Webhooks
# > your endpoint > "Signing secret" (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Optional: apply a Stripe Tax Rate to checkout line items.
STRIPE_TAX_RATE_ID=
# Optional: override the Stripe API host (testing / proxies only).
STRIPE_API_BASE=
USDT_ADDRESS=

# ---------------------------------------------------------------------------
# Unified Inbox channels
# Status is visible at GET /api/channels. Nothing here is required to run the
# app — an unset channel simply reports "needs-credentials".
#
# Shared by every Meta channel (WhatsApp, Messenger, Instagram):
#   META_APP_SECRET     verifies X-Hub-Signature-256 on inbound webhooks.
#                       Required. Without it any POST to the webhook URL can
#                       forge inbound messages. App Dashboard > Settings > Basic.
#   WEBHOOK_VERIFY_TOKEN a string you invent; echoed back during Meta's GET
#                       handshake. Same name as in wsapi-dashboard.
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API (names mirror printezy247/wsapi-dashboard)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE=https://graph.facebook.com

# Facebook Messenger — needs pages_messaging via App Review for production
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# Instagram DM — Business/Creator account linked to the Facebook Page above
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Threads — replies and mentions only; Threads has no direct-message API
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Inbound email. Outbound already works via EMAIL_API_KEY/EMAIL_FROM above;
# this is the shared secret your provider signs inbound webhooks with.
EMAIL_INBOUND_SECRET=

# TikTok has no public direct-message API, so it needs no keys and reports
# "unsupported". Comment access requires approved scopes and cannot back a DM inbox.

# File location for JSON stores (defaults to <project>/db)
DATA_DIR=
# TG Ezy AI OS — environment configuration
# Copy to .env and fill in your values.

# Telegram bot token (required) — from @BotFather
BOT_TOKEN=your-telegram-bot-token

# AI provider
AI_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key

# AI tuning (optional)
AI_MODEL=mistral-tiny
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=30000
AI_RETRIES=3

# Web server
PORT=3000
# Public base URL for webhook links shown in the bot (e.g. https://your-app.fly.dev)
PUBLIC_URL=
# Comma-separated allowed origins for the dashboard API (default * = all)
CORS_ORIGIN=
# Requests per minute per IP for the /api/chat + inbox reply endpoints
RATE_LIMIT=30

# Unified inbox simulation (default ON). Set to false to disable seeding.
INBOX_SIM=true

# Monetization (optional)
ADMIN_TELEGRAM_ID=
PRO_ACCESS_IDS=

# File location for JSON stores (defaults to <project>/db)
DATA_DIR=